{
  "name": "@alilc/lowcode-plugin-inject",
  "author": "ens",
  "version": "1.2.4",
  "description": "lowcode-plugin-inject",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && vite build",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "beta": "npm publish --tag beta",
    "pub": "npm publish"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alibaba/lowcode-tools.git",
    "directory": "packages/lowcode-plugin-inject"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@alilc/lowcode-engine": "workspace:*",
    "@alilc/lowcode-types": "workspace:*",
    "@alilc/lowcode-utils": "workspace:*",
    "case": "^1.6.3",
    "fetch-jsonp": "^1.4.0",
    "lodash": "^4.18.1",
    "query-string": "^9.5.1",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@alifd/next": "^1.27.34",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.26",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass": "^1.105.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2"
  },
  "license": "MIT"
}
