{
  "name": "@alifd/build-plugin-lowcode",
  "version": "0.4.7",
  "description": "build plugin for component-to-lowcode",
  "type": "commonjs",
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "keywords": [
    "plugin"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && vite build",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "pub": "npm publish",
    "beta": "npm publish --tag=beta"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alibaba/lowcode-tools.git",
    "directory": "packages/build-plugin-lowcode"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@alilc/lowcode-material-parser": "workspace:*",
    "@alilc/lowcode-rax-renderer": "^1.2.5",
    "@alilc/lowcode-react-renderer": "workspace:*",
    "@alilc/lowcode-types": "workspace:*",
    "@alilc/lowcode-utils": "workspace:*",
    "@babel/core": "^7.28.5",
    "axios": "^1.20.0",
    "build-plugin-component": "^1.12.2",
    "build-scripts-config": "^3.0.3",
    "chokidar": "^3.6.0",
    "cross-spawn-promise": "^0.10.2",
    "driver-universal": "^3.5.0",
    "fs-extra": "^11.4.1",
    "glob": "^7.2.3",
    "handlebars": "^4.7.10",
    "html-webpack-plugin": "^3.2.0",
    "is-wsl": "^2.2.0",
    "lodash": "^4.18.1",
    "rax-babel-config": "^2.0.4",
    "rpx-loader": "^1.0.1",
    "style-loader": "^2.0.0",
    "webpack": "^4.46.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2"
  }
}
