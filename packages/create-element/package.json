{
  "name": "@alilc/create-element",
  "version": "1.2.0",
  "description": "Scaffolding CLI for Ali LowCode engine elements (component / setter / plugin / editor)",
  "type": "module",
  "bin": {
    "create-element": "./dist/index.mjs"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && vite build",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "pub": "npm publish --tag latest",
    "beta": "npm publish --tag beta"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alibaba/lowcode-tools.git",
    "directory": "packages/create-element"
  },
  "author": "eternalsky",
  "license": "MIT",
  "dependencies": {
    "case": "^1.6.3",
    "chalk": "^6.0.1",
    "cross-spawn": "^7.0.6",
    "dayjs": "^1.11.23",
    "ejs": "^7.0.2",
    "fie-api": "^3.1.12",
    "fs-extra": "^11.4.1",
    "glob": "^13.0.6",
    "inquirer": "^14.2.3",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/ejs": "^3.1.5",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.5",
    "@types/yargs": "^17.0.35",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
