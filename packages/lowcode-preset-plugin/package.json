{
  "name": "@alilc/lowcode-preset-plugin",
  "version": "0.1.2",
  "description": "LowCodeEngine preset plugin collection",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && vite build",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "mark.ck",
  "license": "MIT",
  "dependencies": {
    "@alifd/next": "^1.27.34",
    "@alilc/lowcode-datasource-fetch-handler": "workspace:*",
    "@alilc/lowcode-engine": "workspace:*",
    "@alilc/lowcode-engine-ext": "workspace:*",
    "@alilc/lowcode-plugin-code-editor": "workspace:*",
    "@alilc/lowcode-plugin-code-generator": "workspace:*",
    "@alilc/lowcode-plugin-components-pane": "workspace:*",
    "@alilc/lowcode-plugin-datasource-pane": "workspace:*",
    "@alilc/lowcode-plugin-inject": "workspace:*",
    "@alilc/lowcode-plugin-manual": "workspace:*",
    "@alilc/lowcode-plugin-schema": "workspace:*",
    "@alilc/lowcode-plugin-simulator-select": "workspace:*",
    "@alilc/lowcode-plugin-undo-redo": "workspace:*",
    "@alilc/lowcode-plugin-zh-en": "workspace:*",
    "@alilc/lowcode-types": "workspace:*",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@alilc/lowcode-react-renderer": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass": "^1.105.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2"
  }
}
